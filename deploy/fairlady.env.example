# RIDE OR DIE — production environment. Copy to deploy/fairlady.env and edit.
# Every var is optional; these are the production choices. See backend/config.py for all knobs.

# --- Her voice --------------------------------------------------------------
# 'ace' = the real FAIRLADY: Nemotron reply + Kokoro audio via rop1's Ace stack.
# 'stub' = offline, deterministic, silent (no GPU needed).
FAIRLADY_ADAPTER=ace
# Ace base URL. If the game runs ON the Ace box (rop1), point this at localhost to skip the
# public round-trip, e.g. http://127.0.0.1:8088 — otherwise the public endpoint works too.
FAIRLADY_ACE_URL=https://ace-api.badler.ai
FAIRLADY_ACE_TIMEOUT=30
FAIRLADY_VOICE=1
# Optional: voice the non-Japanese NPCs via an OpenAI-compatible Kokoro server (/v1/audio/speech).
# FAIRLADY_KOKORO_URL=http://127.0.0.1:8003

# --- World / routing --------------------------------------------------------
# 'osm' = live Nominatim geocode + OSRM routing (disk-cached). Linux Python has modern OpenSSL,
# so this works on rop1. 'offline' = haversine only, no network.
FAIRLADY_ROUTING=osm
# Be a good citizen to the public OSM demo servers (or point these at your own instances).
FAIRLADY_USER_AGENT=RIDE-OR-DIE-game/1.0 (contact: ben@badler.ai)
# FAIRLADY_NOMINATIM_URL=https://nominatim.openstreetmap.org
# FAIRLADY_OSRM_URL=https://router.project-osrm.org
